<h1>Write Your Part</h1>

<p class="story-meta"><strong>Turn {{add room.currentTurn 1}}</strong> of {{room.players.length}}</p>
<p class="story-meta">Story #{{storyIndex}}</p>
<p class="story-meta">Time Left: <span id="timer">{{timeLeft}}</span> seconds</p>

{{#if showGeneratePromptButton}}
<button type="button" id="generatePromptBtn">
    Generate Story Prompt
</button>
{{/if}}

<form id="writeForm" action="/games/story/{{code}}/write"
    method="POST">
    <textarea class="story-textarea" name="content" rows="12" maxlength="20000" required>{{previousContent}}</textarea>
    <input type="hidden" name="code" value="{{code}}">
    <input type="hidden" name="turn" value="{{room.currentTurn}}">
    <input type="hidden" name="username" value="{{username}}">
    <br>
</form>

<p class="story-meta">Time Left: <span id="timer2">{{timeLeft}}</span> seconds</p>

<audio id="bagpipe-audio" preload="auto">
    <source src="/audio/bagpipes.mp3" type="audio/mpeg">
</audio>
<script nonce="{{cspNonce}}">
    const scotlandMode = {{ room.settings.enableScotlandMode }};

    if (scotlandMode) {
        document.body.classList.add('scotland-mode');
    }

    function playMusic(musicEnabled) {
        if (musicEnabled) {
            const bagpipeAudio = document.getElementById('bagpipe-audio');
            bagpipeAudio.play();
        }
    }
    document.getElementById('writeForm').addEventListener('click', () => playMusic(scotlandMode), { once: true });
</script>

<script src="/socket.io/socket.io.js"></script>
<script nonce="{{cspNonce}}">
    const socket = io();
    const code = "{{code}}";
    const username = "{{username}}";
    socket.emit('join-room', code);
    let time = {{ timeLeft }};
    const timerEl = document.getElementById('timer');
    const timerEl2 = document.getElementById('timer2');
    const form = document.getElementById('writeForm');

    const countdown = setInterval(() => {
        time--;
        timerEl.textContent = time;
        timerEl2.textContent = time;
        if (time <= 0) {
            clearInterval(countdown);
            form.submit(); // or lock input and wait for server redirect
        }
    }, 1000);

    socket.on("start-turn", ({ turn, endsIn }) => {
        window.location.href = `/games/story/${code}/write?turn=${turn}&username=${encodeURIComponent(username)}`;
    });

    socket.on("start-reading-phase", ({ turn, endsIn }) => {
        window.location.href = `/games/story/${code}/reading?username=${encodeURIComponent(username)}`;
    });

    socket.on("game-finished", () => {
        window.location.href = `/games/story/${code}/results`;
    });
</script>
<script nonce="{{cspNonce}}">
    const generatePromptBtn = document.getElementById('generatePromptBtn');

    if (generatePromptBtn) {
        generatePromptBtn.addEventListener('click', async () => {
            const response = await fetch('/api/getWritingPrompt');
            const data = await response.json();

            document.querySelector('.story-textarea').value = data.prompt;
        });
    }
</script>
