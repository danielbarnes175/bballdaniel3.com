<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if title}}{{title}}{{else}}bballdaniel3.com{{/if}}</title>
    <script nonce="{{cspNonce}}">
        (function () {
            try {
                var t = localStorage.getItem('site-theme');
                if (!t) {
                    t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
                }
                if (t === 'dark') {
                    document.documentElement.classList.add('dark-theme');
                } else {
                    document.documentElement.classList.remove('dark-theme');
                }
            } catch (e) { /* no-op */ }
        })();
    </script>
    <link rel="stylesheet" href="/css/animations.css">
    <link rel="stylesheet" href="/css/blog.css">
    <link rel="stylesheet" href="/css/collections.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/guestbook.css">
    <link rel="stylesheet" href="/css/games.css">
    <link rel="stylesheet" href="/css/projects.css">
    <link rel="stylesheet" href="/css/politics.css">
    <link rel="stylesheet" href="/css/summoning.css">
    <script defer src="/vendor/swup/swup.umd.js"></script>
    <script defer src="/vendor/swup/forms-plugin.umd.js"></script>
    <script defer src="/vendor/swup/head-plugin.umd.js"></script>
    <script defer src="/vendor/swup/scroll-plugin.umd.js"></script>
    <script defer src="/vendor/swup/scripts-plugin.umd.js"></script>
    <script defer type="module" src="/js/swup.js"></script>
    <script defer src="/js/theme.js"></script>
    <script defer src="/js/summoning.js"></script>
</head>

<body id="swup" class="main-background">
    <header>
        {{> navbar }}
    </header>
    <main class="transition-fade transition-slide">
        <div class="horizontal-margins-lg">
            {{{body}}}
        </div>
    </main>
    <footer>
        {{> footer }}
    </footer>
</body>

</html>
